// Settings, window rules and binds for the niri engine, loaded only while it runs. bento copies this
// file to ~/.config/bento/engines/niri.kdl the first time the engine runs without one; from then
// on it's yours to edit.
//
// A key bound here and in config.kdl runs the bind here while this engine runs.
// https://github.com/faetalize/bento#layout-engines

// Everything below is at its default.
//
// Settings can differ per output and per named workspace: an `output` or `workspace` block next to
// `settings` holds the settings that change there. A workspace has the settings above, then those
// of its output, then its own, each replacing the one before it:
//
// output "DP-2" {
//     settings {
//         default-column-width "33.333%"
//     }
// }
//
// workspace "web" {
//     settings {
//         tab-indicator-position "top"
//     }
// }
settings {
    // When to center a column when changing focus, options are:
    // - "never", focusing an off-screen column will keep it at the left or right edge of the
    //   screen.
    // - "always", the focused column will always be centered.
    // - "on-overflow", focusing a column will center it if it doesn't fit together with the
    //   previously focused column.
    center-focused-column "never"

    // Center a column that is alone on its workspace, whatever center-focused-column says.
    always-center-single-column false

    // The width that new windows open with. Written as a proportion of the working area, like
    // "50%", or as logical pixels, like "960".
    // Leave it empty to let the windows decide their initial width:
    // default-column-width
    default-column-width "50%"

    // The widths that "switch-preset-column-width" cycles through. Proportions take gaps into
    // account: you can perfectly fit four windows sized "25%".
    preset-column-widths "33.333%" "50%" "66.667%"

    // The heights that "switch-preset-window-height" cycles through.
    preset-window-heights "33.333%" "50%" "66.667%"

    // How a new column shows its windows: "normal", stacked, or "tabbed", one at a time with a
    // tab indicator.
    default-column-display "normal"

    // The tab indicator of tabbed columns. Colors are written "#rgb", "#rrggbb" or "#rrggbbaa",
    // and gradients with properties, see the gradient examples below.
    tab-indicator true
    // Which side of the column it sits on: "left", "right", "top" or "bottom".
    tab-indicator-position "left"
    // How thick it is, and how far from the column, in logical pixels.
    tab-indicator-width 4
    tab-indicator-gap 5
    // How much of the column's side it takes up, as a proportion.
    tab-indicator-length 0.5
    tab-indicator-corner-radius 0
    // The space between its tabs.
    tab-indicator-gaps-between-tabs 0
    // Draw it inside the column, over the windows, instead of next to it.
    tab-indicator-place-within-column false
    // Leave it out while the column has only one tab.
    tab-indicator-hide-when-single-tab false
    tab-indicator-active-color "#7fc8ff"
    tab-indicator-inactive-color "#505050"
    tab-indicator-urgent-color "#9b0000"
    // A gradient replaces the color of its tab. It goes from one color to another at an angle in
    // degrees, 0 being up and 90 to the right (180, top to bottom, when left out). It spans the
    // tab, or with relative-to="view" the whole view, and is mixed in the color space of `in`:
    // "srgb", "srgb-linear", "oklab", or "oklch" with "shorter hue", "longer hue", "increasing
    // hue" or "decreasing hue". None is set by default:
    // tab-indicator-active-gradient from="#80c8ff" to="#c7ff7f" angle=45 relative-to="view" in="oklch shorter hue"
    // tab-indicator-inactive-gradient from="#505050" to="#303030"
    // tab-indicator-urgent-gradient from="#9b0000" to="#ff5050"

    // The hint that shows where a window will go while you drag it.
    insert-hint true
    insert-hint-color "#7fc8ff80"
    // A gradient replaces the color of the hint, written like the tab indicator's. None by default:
    // insert-hint-gradient from="#80c8ff80" to="#c7ff7f80" angle=45

    // Focus a window when the pointer comes onto it, floating windows and panels that take the
    // keyboard on demand included: "never", "in-view" for windows already fully in view, which
    // focusing doesn't scroll to, or "always".
    focus-follows-mouse "never"
}

// Window rules have the same match and exclude as the ones in config.kdl, and set what the
// engine declares: default-column-width, default-window-height, default-column-display,
// open-maximized, and the colors and gradients of the window's tab in the tab indicator, like
// tab-indicator-active-color "#ff5050" or
// tab-indicator-inactive-gradient from="#303030" to="#101010". See "bento msg engine" for their
// types.

// Work around WezTerm's initial configure bug
// by leaving its default-column-width empty.
window-rule {
    // This regular expression is intentionally made as specific as possible,
    // since this is the default config, and we want no false positives.
    // You can get away with just app-id="wezterm" if you want.
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width
}

// The engine's shortcuts come with it, on their default keys, and Settings lists them. Your own
// keys for them go in a binds section here, replacing a shortcut's defaults, and unbind turns one
// off:
//
// binds {
//     Mod+Shift+Left { focus-column-left; }
//     unbind { toggle-column-tabbed-display; }
// }
